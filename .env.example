# Server-only Nebius Token Factory credentials. Never use a VITE_ prefix for secrets.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Optional exact Nemotron IDs from GET /v1/models for this endpoint/account.
# Empty values auto-select an available Nemotron (Nano preferred for fast, Ultra for deep).
NEBIUS_FAST_MODEL=
NEBIUS_DEEP_MODEL=

PORT=3000
# DISABLE_HMR=true
